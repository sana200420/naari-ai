# ---- secrets: never commit these ----
.env
.env.local
*.key
credentials.json

# ---- python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# ---- node / next.js ----
node_modules/
.next/
out/
dist/
.vercel/

# ---- models & big artefacts (use HF Hub, not git) ----
*.onnx
*.bin
*.safetensors
*.pt
models/

# ---- os junk ----
.DS_Store
Thumbs.db

# ---- pitch materials: large binaries, not code ----
slidedeck/
assets/*.mp4
assets/*.pptx
eval/.dod_checkpoint.json
eval/.danger_gate_summary.json
eval/.negative_set_summary.json
eval/negative_set_false_positives.csv
data/variants/_progress.json

# Generated supervisor/report PDFs. Kept out of the repo on purpose: Hugging
# Face rejects binary files that are not in Xet/LFS, and scripts/deploy_space.py
# strips only frontend/, so a committed PDF here fails the next Space deploy.
# Regenerate from the markdown in docs/ when one is needed.
docs/*.pdf
