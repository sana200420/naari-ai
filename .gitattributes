# Normalise line endings so Windows/Linux edits don't show up as
# thousands of fake changed lines in every diff.
* text=auto eol=lf

# Data files: always LF, never converted
*.csv  text eol=lf
*.tsv  text eol=lf
*.json text eol=lf

# Shell scripts must keep LF or they break
*.sh text eol=lf

# Treat these as binary — never diff or convert them
*.gz    binary
*.pptx  binary
*.pdf   binary
*.mp4   binary
*.onnx  binary
