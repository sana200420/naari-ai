# Copy this file to .env and fill in real values.
# .env is gitignored. NEVER commit real keys.

# --- LLM generation ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- vector store ---
QDRANT_URL=
QDRANT_API_KEY=

# --- logging / feedback ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- app config ---
TAU_HIGH=0.75
TAU_LOW=0.2034
DEMO_MODE=false

# --- variant index (Phase 3) ---
# Colloquial rewordings of the KB questions, indexed alongside the canonical
# rows as lang="sd_var". Ships OFF: every recall number on record was measured
# with these legs off, so turning them on by default would invalidate the
# baseline they exist to be compared against. Flip it only once
# eval/variant_index_lift.csv shows the lift, produced by
# retrieval/scripts/build_variant_index.ipynb.
USE_VARIANT_INDEX=false
# How much the variant legs count against the canonical ones in RRF. 1.0 gives
# them an equal vote; lower makes them a tiebreaker. 0 makes them inert, which
# is the way to neutralise the feature without a redeploy.
VARIANT_WEIGHT=1.0
