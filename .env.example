# Copy this file to .env and fill in real values.
# .env is gitignored. NEVER commit real keys.

# --- LLM generation ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- vector store ---
QDRANT_URL=
QDRANT_API_KEY=

# --- logging / feedback ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- app config ---
TAU_HIGH=0.75
TAU_LOW=0.2034
DEMO_MODE=false

# --- variant index (Phase 3) ---
# Colloquial rewordings of the KB questions, indexed alongside the canonical
# rows as lang="sd_var". Ships OFF: every recall number on record was measured
# with these legs off, so turning them on by default would invalidate the
# baseline they exist to be compared against. Flip it only once
# eval/variant_index_lift.csv shows the lift, produced by
# retrieval/scripts/build_variant_index.ipynb.
#
# A first version fused variant legs into the same weighted-RRF competition
# as the canonical legs (a VARIANT_WEIGHT env var controlled the blend). A
# Colab measurement showed that design regresses Recall@1 by 0.125 for a
# Recall@20 gain of just 0.008 -- noisy variant matches were outranking and
# displacing correct canonical rows before reranking ever saw them. Variants
# are now a strict rescue leg (retrieval/pipeline.py's search(), same pattern
# as the Lever 4 English cascade): canonical candidates are never evicted,
# variant hits can only fill in candidates canonical search did not already
# find.
USE_VARIANT_INDEX=false
# How many EXTRA candidates the variant rescue leg may add beyond the
# canonical top-candidate_k, for the reranker to consider. 0 makes the
# rescue leg inert, which is how the feature gets neutralised without a
# redeploy if it ever misbehaves in production.
VARIANT_RESCUE_K=10
